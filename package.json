	},
	"dependencies": {
		"@uppy/core": "^4.5.1",
		"@uppy/dashboard": "^4.4.1",
		"@uppy/drag-drop": "^4.2.1",
		"@uppy/progress-bar": "^4.3.1",
		"@uppy/svelte": "^4.6.1",
		"@uppy/tus": "^4.3.1"
	}
